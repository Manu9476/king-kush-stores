# Core environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace_with_a_long_random_secret_key

# Hosts and CORS
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost(:\d+)?$,^http://127\.0\.0\.1(:\d+)?$
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# Marketplace
MARKETPLACE_COMMISSION_RATE=0.10
MARKETPLACE_MPESA_ACCOUNT_REFERENCE=0701137747
MARKETPLACE_PAYOUT_MODE=automatic
MARKETPLACE_EARNINGS_RELEASE_POLICY=on_payment
MARKETPLACE_STOCK_RESERVATION_MINUTES=30

# M-Pesa mode and credentials
MPESA_ENVIRONMENT=sandbox
MPESA_ENABLE_LIVE=False
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_STK_CALLBACK_URL=

# B2C payouts
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=
MPESA_B2C_COMMAND_ID=BusinessPayment

# Security hardening
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_CONTENT_TYPE_NOSNIFF=False
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
